      "accentBright": { "value": "#ff7a70", "type": "color", "description": "Accent TEXT on forest · 5.2:1" },
      "accentDeep":   { "value": "#cf3720", "type": "color", "description": "Accent TEXT on paper; every figure in a stat line · 4.7:1" },
