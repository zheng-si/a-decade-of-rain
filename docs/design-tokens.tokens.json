{
  "$description": "A Decade of Rain — design tokens. Import with the free Tokens Studio for Figma plugin (Import > paste this JSON), then push to Figma variables / styles. Legacy value/type format for broad compatibility. Sizes are px at the 100% root; the shipped site scales the root to 85% (13.6px) between 641 and 1600px viewport width, so every value below moves together. Spec: docs/design-system.md",
  "color": {
    "surface": {
      "paper":       { "value": "#faf9f4", "type": "color", "description": "Page background; glass panels with alpha (rgb 250,249,244)" },
      "paperSolid":  { "value": "#fdfdfd", "type": "color", "description": "Solid paper: popups, map key" },
      "forest":      { "value": "#213528", "type": "color", "description": "Dark surface: story cards, filled controls" },
      "forest2":     { "value": "#2c3730", "type": "color", "description": "Raised dark surface (stat pill bg)" }
    },
    "ink": {
      "ink":      { "value": "#213528", "type": "color", "description": "Titles AND structural labels (small tracked caps) · 12.4:1" },
      "inkSoft":  { "value": "#4e6355", "type": "color", "description": "Content: body, legend rows, stat labels, dates · 6.2:1" },
      "inkFaint": { "value": "#647468", "type": "color", "description": "Notes about content: coordinates, axis years, table values · 4.7:1 (AA floor)" },
