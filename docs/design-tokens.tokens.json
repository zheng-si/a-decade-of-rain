      "mint":           { "value": "#92f7bc", "type": "color", "description": "Decorative borders only · never text" }
    },
    "accent": {
      "accent":       { "value": "#ff5449", "type": "color", "description": "GEOMETRY: dots, pulse rings, heat, rain, chart bars" },
