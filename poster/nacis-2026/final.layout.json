  {"type":"text","x":2.63,"y":14.947,"w":0.736,"h":0.153,"text":"RECORDS","family":"Geist","style":"Medium","sizePt":7.5,"lineHeight":1.5,"letterSpacing":0.08,"transform":"uppercase","align":"left","color":"#4e6355","resize":"HEIGHT"},
  {"type":"text","x":0.333,"y":15.211,"w":6.917,"h":0.458,"text":"Source: the HERBS file of U.S. military herbicide missions, as republished in andrewstellman/hea-v (Stellman, Stellman, Christian, Weber & Tomasallo, Nature 422, 2003). Basemap OpenFreeMap · terrain AWS Terrain Tiles · MapLibre GL. Two static pages: no backend, no accounts, no analytics.","family":"Geist","style":"Regular","sizePt":8,"lineHeight":1.5,"letterSpacing":0,"transform":"none","align":"left","color":"#647468","resize":"NONE"},
